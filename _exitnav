#!/bin/bash

id="$1"
on_exit="$2"
abs_dir=`getAbsDir "$id"`
name=`getName "$id"`

path="$abs_dir/$name"
#echo "$path" > /tmp/deb

if [[ -z "$name" || "$name" == "total" ]];then
  echo "" > $FILE_WARP_TMP_PATH/$id/kill
  echo "" > $FILE_WARP_TMP_PATH/$id/list_on_exit

  #TODO should move on_exit hook to navdown(2)
  #eval "$on_exit $abs_dir"
#elif [[ "$mode" == "normal" ]]; then
elif [[ -d "$path" ]]; then
  echo "" > $FILE_WARP_TMP_PATH/$id/kill
    #setQueryStr "$id" ""
  setName "$id" ""
  setAbsDir "$id" "$path"
  #eval "$on_exit $path"
elif [[ -f "$path" ]]; then
  eval "$on_exit $path"
  #echo "" > $FILE_WARP_TMP_PATH/$id/kill
fi

