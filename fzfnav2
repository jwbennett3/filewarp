fi

if [[ -z "$on_enter" ]];then
  on_enter="echo;"
fi
if [[ -z "$on_up" ]];then
  on_up="navupr"
fi
if [[ -z "$on_open" ]];then
  on_open="addRecentFile"
fi
if [[ -z "$alt_open" ]];then
  alt_open="$on_open"
fi
if [[ -z "$on_exit" ]];then
  on_exit="command cd"
fi
if [[ -z "$alt_exit" ]];then
  alt_exit="echo;"
fi

if [[ -z "$view" ]]; then
  view="normalView"
fi
if [[ -z "$sort_by" ]]; then
  sort_by="alpha"
fi

if [[ -z "$mode" ]]; then
  mode="normal"
fi
if [[ -z "$id" ]];then
  id="$$"
fi

on_enter_state=`getOnEnter "$id"`
if [[ -z "$on_enter_state" ]];then
  setOnEnter "$id" "$on_enter"
fi

#on_exit_state=`getOnExit "$id"`
#if [[ -z "$on_exit_state" ]];then
  setOnExit "$id" "$on_exit"
#fi

