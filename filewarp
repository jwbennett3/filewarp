#!/bin/bash -e

start="$1"
mode=${2:-normal}
from_ide=${3:-0}

if [[ $from_ide == 1 ]];then
  export id=0
else
  export id=$PPID
fi

mkdir -p "$FILE_WARP_TMP_PATH"
navdown2 "$start" "$mode"


abs_dir="$(cat "$FILE_WARP_TMP_PATH/$id/abs_dir")"
name="$(cat "$FILE_WARP_TMP_PATH/$id/name")"

if [[ $from_ide == 0 ]];then
  if [[ $TERM == "xterm-kitty" ]];then
    if [[ -f "$abs_dir/$name" ]];then
      openFileForEditing server$INDEX "$abs_dir/$name" &
      if [[ "$mode" == normal ]];then
        cd "$abs_dir"
      fi
    else
      if [[ "$mode" == normal ]];then
        cd "$abs_dir"
      fi
    fi
  else
    if [[ -f "$abs_dir/$name" ]];then
      editText "$abs_dir/$name"
      if [[ "$mode" == normal ]];then
        cd "$abs_dir"
      fi
    else
      if [[ "$mode" == normal ]];then
        cd "$abs_dir"
      fi
    fi
  fi
fi
