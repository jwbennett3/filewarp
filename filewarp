#!/bin/bash -e

start="$1"
mode=${2:-normal}
from_ide=${3:-0}
called_from_index="$4"
if [[ $from_ide == 1 ]];then
  export id=0
else
  #export id=$PPID
  export id=$$
fi
mkdir -p "$FILE_WARP_TMP_PATH/$id"
touch "$FILE_WARP_TMP_PATH/$id/abs_dir"
touch "$FILE_WARP_TMP_PATH/$id/name"
. navdown2 "$start" "$mode"

if [[ -f "$FILE_WARP_TMP_PATH/$id/restart_as_root" ]]; then
  dir=$(cat "$FILE_WARP_TMP_PATH/$id/restart_as_root")
  rm -f "$FILE_WARP_TMP_PATH/$id/restart_as_root"
  sudo env FILE_WARP_TMP_PATH="$FILE_WARP_TMP_PATH" original_user="${USER:-$(id -un)}" filewarp "$dir" "$mode"
  return 2>/dev/null || exit
fi

if [[ -f "$FILE_WARP_TMP_PATH/$id/restart_as_normal" ]]; then
  dir=$(cat "$FILE_WARP_TMP_PATH/$id/restart_as_normal")
  original_user=$(cat "$FILE_WARP_TMP_PATH/$id/restart_as_normal_user")
  rm -f "$FILE_WARP_TMP_PATH/$id/restart_as_normal"
  rm -f "$FILE_WARP_TMP_PATH/$id/restart_as_normal_user"
  sudo -u "$original_user" env FILE_WARP_TMP_PATH="$FILE_WARP_TMP_PATH" filewarp "$dir" "$mode"
  return 2>/dev/null || exit
fi

abs_dir="$(cat "$FILE_WARP_TMP_PATH/$id/abs_dir")"
name="$(cat "$FILE_WARP_TMP_PATH/$id/name")"
abs_path="$abs_dir/$name"
 
if [[ -n "$out_reg" ]];then
  echo "$abs_dir" > "$out_reg/curr_dir"
fi

if [[ $from_ide == 0 ]];then
  if [[ $TERM == "xterm-kitty" ]];then
    if [[ -f "$abs_path" ]];then
      if [[ $(file -b --mime-type workspaceFromTerminal) == "text"* ]];then
        openFileForEditing $INDEX "$abs_path" &
      else
        open "$abs_path"
      fi
      if [[ "$mode" == normal ]];then
        cd "$abs_dir"
      fi
    else
      if [[ "$mode" == normal ]];then
        cd "$abs_dir"
      fi
    fi
  else
    if [[ -f "$abs_dir/$name" ]];then
      open "$abs_path"
      if [[ "$mode" == normal ]];then
        cd "$abs_dir"
      fi
    else
      if [[ "$mode" == normal ]];then
        cd "$abs_dir"
      fi
    fi
  fi
else
  if [[ -f "$abs_dir/$name" ]];then
    openFileForEditing "$called_from_index" "$abs_dir/$name" normal
  fi
  focusActiveEditor
fi
